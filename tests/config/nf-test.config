params {
    publish_dir_mode                  = "copy"
    singularity_pull_docker_container = false
    test_data_base                    = 'https://raw.githubusercontent.com/CDCgov/oamd-bio-test-data/modules'
    modules_testdata_base_path        = 'https://raw.githubusercontent.com/CDCgov/oamd-bio-test-data/modules/data'
    nfcore_test_data_base             = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules'
    nfcore_modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data'
    snpeff_db                         = 'mtb_NC_000962_3'
}

process {
    cpus   = 2
    memory = '4.GB'
    time   = '2.h'

    // Container overrides from amd-ph-core/configs containers.config
    // Uses simple names to match against any workflow-qualified process name
    withName: CAT_FASTQ {
        container = 'cdc-amd/ubuntu:24.04_e2e9f67_v9'
    }
    // No fadso image is published yet, so only its stub is tested and a generic
    // ubuntu image is enough to run it. Drop this override once the image built
    // from oamd-infra-dockerfiles is available.
    // falco comes from BioContainers rather than an internal image. The module
    // declares the bare name per nf-core convention, so it needs the plain
    // quay.io registry rather than the quay.io/us-cdcgov default set below.
    withName: FALCO {
        container = 'quay.io/biocontainers/falco:1.2.5--h077b44d_0'
    }
    // fadso has no published image anywhere, so only its stub is tested and any
    // image with a shell is sufficient. Fully qualified so it bypasses the
    // quay.io/us-cdcgov registry default below.
    withName: FADSO {
        container = 'docker.io/library/ubuntu:24.04'
    }
    // Likewise hostess: no image is published yet, so only its stub is tested.
    withName: HOSTESS {
        container = 'docker.io/library/ubuntu:24.04'
    }
    // deacon comes from BioContainers, like falco, so the module declares the
    // bare name per nf-core convention and needs the plain quay.io registry
    // rather than the quay.io/us-cdcgov default set below. Note that image
    // carries no bgzip, so these tests exercise the module's fallback to
    // deacon's own gzip writer; the AMDP image takes the bgzip path.
    withName: 'DEACON_FILTER|DEACON_INDEX' {
        container = 'quay.io/biocontainers/deacon:0.17.0--h3edb6b3_0'
    }
    withName: TRIMMOMATIC {
        container = 'cdc-amd/trimmomatic:0.39_cc5ff96_v4'
    }
    withName: BWA_INDEX {
        container = 'cdc-amd/bwa:0.7.19_639f31d_v9'
    }
    withName: VARPIPE_BWAMEM {
        container = 'cdc-amd/bwa:0.7.19_639f31d_v9'
    }
    withName: PICARD_CREATESEQUENCEDICTIONARY {
        container = 'cdc-amd/picard:3.4.0_ac49616_v8'
    }
    withName: PICARD_MARKDUPLICATES {
        container = 'cdc-amd/picard:3.4.0_ac49616_v8'
    }
    withName: PICARD_SORTSAM {
        container = 'cdc-amd/picard:3.4.0_ac49616_v8'
    }
    withName: PICARD_SAMFORMATCONVERTER {
        container = 'cdc-amd/picard:3.4.0_ac49616_v8'
    }
    withName: PICARD_BUILDBAMINDEX {
        container = 'cdc-amd/picard:3.4.0_ac49616_v8'
    }
    withName: SAMTOOLS_FAIDX {
        container = 'cdc-amd/samtools:1.22.1_cc13003_v8'
    }
    withName: SAMTOOLS_VIEW {
        container = 'cdc-amd/samtools:1.22.1_cc13003_v8'
    }
    withName: SAMTOOLS_DEPTH {
        container = 'cdc-amd/samtools:1.22.1_cc13003_v8'
    }
    withName: GATK4_MUTECT2 {
        container = 'cdc-amd/gatk:4.6.2.0_01dac55_v7'
    }
    withName: GATK4_LEFTALIGNANDTRIMVARIANTS {
        container = 'cdc-amd/gatk:4.6.2.0_01dac55_v7'
    }
    withName: GATK4_FILTERMUTECTCALLS {
        container = 'cdc-amd/gatk:4.6.2.0_01dac55_v7'
    }
    withName: SNPEFF_SNPEFF {
        container = 'cdc-amd/snpeff:5.2f_b1412d0_v10'
    }
    withName: VARPIPE_COVERAGEANALYSIS {
        container = 'cdc-amd/python:3.12-tb_716b886_v4'
    }
    withName: VARPIPE_STRUCTURALVARIANTS {
        container = 'cdc-amd/python:3.12-tb_716b886_v4'
    }
    withName: VARPIPE_CREATEANNOTATIONS {
        container = 'cdc-amd/python:3.12-tb_716b886_v4'
    }
    withName: VARPIPE_PARSEANNOTATIONS {
        container = 'cdc-amd/python:3.12-tb_716b886_v4'
    }
    withName: VARPIPE_LINEAGE {
        container = 'cdc-amd/python:3.12-tb_716b886_v4'
    }
    withName: VARPIPE_REPORT {
        container = 'cdc-amd/python:3.12-tb_716b886_v4'
    }
    withName: VARPIPE_INTERPRETATION {
        container = 'cdc-amd/python:3.12-tb_716b886_v4'
    }
    withName: VARPIPE_PDF {
        container = 'cdc-amd/python:3.12-tb_716b886_v4'
    }
    withName: VARPIPE_TAR {
        container = 'cdc-amd/ubuntu:24.04_e2e9f67_v9'
    }

    // Aliased process overrides (same container as base process)
    withName: GATK4_MUTECT2_ALL {
        container = 'cdc-amd/gatk:4.6.2.0_01dac55_v7'
    }
    withName: GATK4_MUTECT2_TARGETED {
        container = 'cdc-amd/gatk:4.6.2.0_01dac55_v7'
    }
    withName: GATK4_LEFTALIGNANDTRIMVARIANTS_ALL {
        container = 'cdc-amd/gatk:4.6.2.0_01dac55_v7'
    }
    withName: GATK4_LEFTALIGNANDTRIMVARIANTS_TARGETED {
        container = 'cdc-amd/gatk:4.6.2.0_01dac55_v7'
    }
    withName: GATK4_FILTERMUTECTCALLS_ALL {
        container = 'cdc-amd/gatk:4.6.2.0_01dac55_v7'
    }
    withName: GATK4_FILTERMUTECTCALLS_TARGETED {
        container = 'cdc-amd/gatk:4.6.2.0_01dac55_v7'
    }
    withName: VARPIPE_SNPEFF_ALL {
        container = 'cdc-amd/snpeff:5.2f_b1412d0_v10'
    }
    withName: VARPIPE_SNPEFF_TARGETED {
        container = 'cdc-amd/snpeff:5.2f_b1412d0_v10'
    }
    withName: PICARD_BUILDBAMINDEX_2 {
        container = 'cdc-amd/picard:3.4.0_ac49616_v8'
    }
    withName: SAMTOOLS_VIEW_UNMAPPED {
        container = 'cdc-amd/samtools:1.22.1_cc13003_v8'
    }
    withName: SAMTOOLS_VIEW_MAPPED {
        container = 'cdc-amd/samtools:1.22.1_cc13003_v8'
    }
    withName: VARPIPE_CREATEANNOTATIONS_TARGETED {
        container = 'cdc-amd/python:3.12-tb_716b886_v4'
    }
    withName: VARPIPE_CREATEANNOTATIONS_ALL {
        container = 'cdc-amd/python:3.12-tb_716b886_v4'
    }
    withName: VARPIPE_PARSEANNOTATIONS_TARGETED {
        container = 'cdc-amd/python:3.12-tb_716b886_v4'
    }
    withName: VARPIPE_PARSEANNOTATIONS_ALL {
        container = 'cdc-amd/python:3.12-tb_716b886_v4'
    }
    withName: UNTAR_SNPEFF {
        container = 'cdc-amd/ubuntu:24.04_e2e9f67_v9'
    }
}

profiles {
    conda {
        conda.enabled           = true
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }
    docker_self_hosted {
        docker.enabled          = true
        docker.fixOwnership     = true
        docker.runOptions       = '--platform=linux/amd64'
    }
    arm {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
    }
    podman {
        podman.enabled          = true
        podman.runOptions      = '-u $(id -u):$(id -g) --userns=keep-id --cgroups=disabled'
    }
    shifter {
        shifter.enabled         = true
    }
    charliecloud {
        charliecloud.enabled    = true
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gitpod {
        executor.name           = 'local'
        executor.cpus           = 4
        executor.memory         = 8.GB
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
}

// Increase time available to build Conda environment
conda { createTimeout = "120 min" }

// Load test_data.config containing paths to test data
// includeConfig 'test_data.config'

manifest {
    nextflowVersion = '!>=24.10.2'
}
trace {
    enabled = false
}
docker.registry      = 'quay.io/us-cdcgov'
podman.registry      = 'quay.io/us-cdcgov'
singularity.registry = 'quay.io/us-cdcgov'
