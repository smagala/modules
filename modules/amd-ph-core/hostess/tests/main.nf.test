nextflow_process {

    name "Test Process HOSTESS"
    script "../main.nf"
    process "HOSTESS"

    tag "modules"
    tag "modules_amdphcore"
    tag "hostess"

    // Stub tests only. No hostess image is published yet, so the real script
    // path cannot run in CI; tests/config/nf-test.config points HOSTESS at a
    // generic ubuntu image, which is all the stub needs. Replace these with
    // real tests once the image exists.

    test("sarscov2 - fastq - paired_end - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ],
                    [ file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                      file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true) ]
                ])
                input[1] = Channel.value(['genome', file("\${projectDir}/modules/amd-ph-core/hostess/tests/ref", checkIfExists: true)])
                input[2] = 'bowtie2'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.fastq[0][1].size() == 2 },
                { assert path(process.out.json[0][1]).text.contains('"aligner": "bowtie2"') },
                // The BAM outputs are optional and --bam was not passed, so
                // asking for them must yield nothing rather than failing.
                { assert process.out.bam.size() == 0 },
                { assert process.out.bai.size() == 0 },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("sarscov2 - fastq - paired_end - bam - stub") {

        options "-stub"
        config "./bam.config"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ],
                    [ file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                      file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true) ]
                ])
                input[1] = Channel.value(['genome', file("\${projectDir}/modules/amd-ph-core/hostess/tests/ref", checkIfExists: true)])
                input[2] = 'bowtie2'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // With --bam the removed reads and their statistics appear.
                { assert process.out.bam[0][1] ==~ ".*/test.host.bam" },
                { assert process.out.bai[0][1] ==~ ".*/test.host.bam.bai" },
                { assert process.out.flagstat.size() == 1 },
                { assert process.out.stats.size() == 1 },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("sarscov2 - fastq - single_end - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:true ],
                    [ file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true) ]
                ])
                input[1] = Channel.value(['genome', file("\${projectDir}/modules/amd-ph-core/hostess/tests/ref", checkIfExists: true)])
                input[2] = 'bowtie2'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // One unpaired output, not a mate pair.
                { assert process.out.fastq[0][1] ==~ ".*/test.clean.fastq.gz" },
                { assert snapshot(process.out).match() }
            )
        }
    }

    // The minimap2 branch is the reason `aligner` is an input. bowtie2 takes an
    // index prefix inside the directory; minimap2 takes a single FASTA or .mmi,
    // so the two produce different --index values from identical reference
    // inputs. Asserted on the command line itself, because a wrong --index is
    // not visible in the stub's outputs.
    test("sarscov2 - fastq - single_end - minimap2 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:true ],
                    [ file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/nanopore/fastq/test.fastq.gz', checkIfExists: true) ]
                ])
                input[1] = Channel.value(['genome', file("\${projectDir}/modules/amd-ph-core/hostess/tests/ref", checkIfExists: true)])
                input[2] = 'minimap2'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.fastq[0][1] ==~ ".*/test.clean.fastq.gz" },
                // The aligner input must actually reach the command. A stub
                // cannot show the resolved --index, but it does echo the
                // aligner into its report, so this catches the input being
                // dropped or defaulted.
                { assert path(process.out.json[0][1]).text.contains('"aligner": "minimap2"') },
                { assert snapshot(process.out).match() }
            )
        }
    }

    // hostess's own --aligner accepts `auto`; this module does not, because the
    // shape of --index is decided here, before hostess runs. `auto` used to fall
    // through to the bowtie2 branch, which would hand a bowtie2 index prefix to
    // a run that may then choose minimap2.
    test("aligner - auto - rejected - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:true ],
                    [ file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/nanopore/fastq/test.fastq.gz', checkIfExists: true) ]
                ])
                input[1] = Channel.value(['genome', file("\${projectDir}/modules/amd-ph-core/hostess/tests/ref", checkIfExists: true)])
                input[2] = 'auto'
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("HOSTESS requires aligner to be 'bowtie2' or 'minimap2'") }
            )
        }
    }
}
