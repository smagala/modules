nextflow_process {

    name "Test Process FALCO"
    script "../main.nf"
    process "FALCO"

    tag "modules"
    tag "modules_amdphcore"
    tag "falco"

    test("sarscov2 - fastq - single_end") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:true ],
                    [ file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true) ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // MultiQC's fastqc/data pattern is "*fastqc_data.txt" - assert the
                // suffix explicitly so a rename cannot silently break MultiQC parsing.
                { assert process.out.txt[0][1] ==~ ".*/test_fastqc_data.txt" },
                // The embedded Filename, not the report path, is what MultiQC's
                // FastQC parser uses as the sample name. Asserting the path only
                // would pass while MultiQC still grouped under the input's name.
                { assert path(process.out.txt[0][1]).text =~ /(?m)^Filename\ttest\.fastq\.gz$/ },
                { assert process.out.html[0][1] ==~ ".*/test_fastqc_report.html" },
                { assert snapshot(
                    process.out.txt,
                    process.out.summary,
                    process.out.versions_falco
                ).match() }
            )
        }
    }

    test("sarscov2 - fastq - paired_end") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ],
                    [ file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                      file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true) ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // Each mate must get its own files - a single falco invocation over
                // both mates would overwrite R1's output with R2's.
                //
                // The names come from the mate's position in the staged list, not
                // from its filename, so they are stable whatever the sequencer
                // called the input. Asserted explicitly: MultiQC derives sample
                // names from these filenames, so a rename silently splits or
                // merges samples in the report.
                { assert process.out.txt[0][1].size() == 2 },
                { assert process.out.txt[0][1][0] ==~ ".*/test_R1_fastqc_data.txt" },
                { assert process.out.txt[0][1][1] ==~ ".*/test_R2_fastqc_data.txt" },
                // The embedded Filename, not the report path, is what MultiQC's
                // FastQC parser uses as the sample name. Asserting the paths
                // only would pass while MultiQC still grouped both mates under
                // the input filenames.
                { assert path(process.out.txt[0][1][0]).text =~ /(?m)^Filename\ttest_R1\.fastq\.gz$/ },
                { assert path(process.out.txt[0][1][1]).text =~ /(?m)^Filename\ttest_R2\.fastq\.gz$/ },
                { assert snapshot(
                    process.out.txt,
                    process.out.summary,
                    process.out.versions_falco
                ).match() }
            )
        }
    }

    test("sarscov2 - fastq - single_end - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:true ],
                    [ file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true) ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("sarscov2 - fastq - paired_end - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ],
                    [ file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                      file(params.nfcore_modules_testdata_base_path + '/genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true) ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // The stub must mirror the real paired-end naming, or downstream
                // stub runs will not exercise MultiQC's parsing path.
                { assert process.out.txt[0][1][0] ==~ ".*/test_R1_fastqc_data.txt" },
                { assert process.out.txt[0][1][1] ==~ ".*/test_R2_fastqc_data.txt" },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
